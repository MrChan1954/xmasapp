{
  "name": "christmas-budget-setup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:money": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/purchases.test.ts",
    "test:currency": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/currency.test.ts",
    "test:recipient-allocations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/recipient-allocations.test.ts",
    "test:owed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/owed.test.ts",
    "test:payment-log": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/payment-log.test.ts",
    "test:validation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/input-validation.test.ts",
    "test:request-origin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/request-origin.test.ts",
    "test:photo-limits": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/photo-limits.test.ts",
    "test:images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/image-resize.test.ts",
    "test:pwa": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/pwa-assets.test.mjs",
    "test:security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/rls-security.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.120.1"
  }
}
